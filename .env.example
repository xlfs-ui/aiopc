DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
APP_ENV=development
COOKIE_SECURE=false
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TRUSTED_HOSTS=localhost,127.0.0.1

# Optional: independent OpenAI-compatible embedding provider (not the chat API).
# Set the provider's API root ending in /v1 when required. Never put keys in VITE_*.
EMBEDDING_BASE_URL=https://api.openai-proxy.org/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
# Leave empty to use the model's default dimensions.
EMBEDDING_DIMENSIONS=
EMBEDDING_MIN_SIMILARITY=0.55
EMBEDDING_INDEX_VERSION=1

# Local: leave DATABASE_URL empty to keep SQLite. Render: use Neon pooled URL.
DATABASE_URL=
# Custom production domain only; Render supplies RENDER_EXTERNAL_URL itself.
PUBLIC_URL=
# Optional initial administrator; set privately in Render, then remove password.
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=
